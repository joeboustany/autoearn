# ===================================================================
# AutoEarn — Environment Variables Template
# Copy this file to .env and fill in real values
# ===================================================================

# Database (SQLite for local dev; switch to Postgres URL for production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys)
# Test mode keys (pk_test_*, sk_test_*) work for sandbox testing.
# Live mode keys (pk_live_*, sk_live_*) work once your Stripe account is approved.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_replace_me
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_replace_me

# ---------------------------------------------------------------------------
# Public site URL (used for Stripe success/cancel redirects + sitemap + robots)
# Set this to your production domain once deployed (e.g. https://autoearn.com)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Z.ai SDK key — auto-injected by the platform, leave blank in production
# ---------------------------------------------------------------------------
ZAI_API_KEY=

# ---------------------------------------------------------------------------
# Admin panel password
# Default: autoearn-admin  → CHANGE THIS to a strong random password in production!
# Generate one with: openssl rand -hex 16
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=autoearn-admin

# ---------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) — optional
# Get yours at https://analytics.google.com → Admin → Data Streams
# When set, gtag.js loads automatically and events flow to GA4.
# Leave empty to disable GA4 (site still works, just no analytics).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Optional: Beehiiv API (for sending real emails to subscribers)
# Sign up at https://beehiiv.com (free up to 2,500 subscribers)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
