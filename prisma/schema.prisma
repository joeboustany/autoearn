// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use postgresql for production (Vercel + Supabase).
  // To switch back to local SQLite dev, change this to "sqlite"
  // and update DATABASE_URL in .env to "file:./db/custom.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("organic")
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  source    String?
  country   String?
  createdAt DateTime @default(now())
}

model RevenueEvent {
  id          String   @id @default(cuid())
  stream      String   // affiliate | digital | ads | subscription
  amount      Float
  currency    String   @default("USD")
  description String?
  createdAt   DateTime @default(now())
}

model Goal {
  id        String @id @default(cuid())
  month     String @unique // "2026-10" format
  target    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateClick {
  id          String   @id @default(cuid())
  productId   String
  productName String
  vendor      String
  source      String   @default("organic") // utm_source or page section
  createdAt   DateTime @default(now())
}

model Payout {
  id          String   @id @default(cuid())
  amount      Float
  currency    String   @default("USD")
  status      String   @default("completed") // completed | pending | failed
  method      String   @default("bank_transfer")
  scheduledAt DateTime
  createdAt   DateTime @default(now())
}
